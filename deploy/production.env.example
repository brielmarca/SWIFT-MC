# Runtime only; copy privately to production.env, mode 600. Never copy staging.env.
APP_ENV=production
BACKEND_RUNTIME=node
NODE_ENV=production
APP_URL=https://swiftmc.com.br
DATABASE_URL=postgresql://swiftmc_production:REPLACE@127.0.0.1:5432/swiftmc_production?schema=public&sslmode=verify-full
DATABASE_SSL_CA_PATH=/run/secrets/db-ca.pem
DATABASE_SSL_SERVERNAME=db.swiftmc.com.br
# Explicit rollout after approval; webhook reconciliation remains active while false.
PURCHASES_ENABLED=false
STRIPE_TEST_PURCHASES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BACKEND_PROXY_SECRET=
MINECRAFT_BRIDGE_SECRET=
MINECRAFT_BRIDGE_SERVER_ID=swift-production
MINECRAFT_BRIDGE_ALLOWED_SERVER_IDS=swift-production
RESEND_API_KEY=
EMAIL_FROM=Swift MC <noreply@swiftmc.com.br>
