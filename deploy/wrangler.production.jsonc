{
  "name": "swift-mc-production",
  "main": "production-gateway.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "routes": [
    { "pattern": "swiftmc.com.br", "custom_domain": true }
  ],
  "vars": {
    "APP_URL": "https://swiftmc.com.br",
    "BACKEND_ORIGIN": "https://origin.swiftmc.com.br"
  }
}
