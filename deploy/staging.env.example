# Copy to deploy/staging.env (ignored), mode 600. Values here are placeholders.
APP_ENV=staging
BACKEND_RUNTIME=node
NODE_ENV=production
APP_URL=https://swift-mc-vps-staging.YOUR-SUBDOMAIN.workers.dev
# Staging-only role; existing PostgreSQL 17 on loopback with Cloudflare Origin CA TLS.
DATABASE_URL=postgresql://swiftmc_staging:REPLACE@127.0.0.1:5432/swiftmc_staging?schema=public&sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://swiftmc_staging:REPLACE@127.0.0.1:5432/swiftmc_staging?schema=public&sslmode=verify-full
DATABASE_SSL_CA_PATH=/run/secrets/db-certs/origin-ca.pem
DATABASE_SSL_SERVERNAME=postgres.swiftmc.internal
PURCHASES_ENABLED=false
STRIPE_TEST_PURCHASES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BACKEND_PROXY_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
RESEND_API_KEY=
EMAIL_FROM=Swift MC Staging <noreply@YOUR-VERIFIED-DOMAIN>
MINECRAFT_BRIDGE_SECRET=
MINECRAFT_BRIDGE_SERVER_ID=swift-staging
MINECRAFT_BRIDGE_ALLOWED_SERVER_IDS=swift-staging
MINECRAFT_HOST=
MINECRAFT_PORT=25565
MINECRAFT_PUBLIC_ADDRESS=
