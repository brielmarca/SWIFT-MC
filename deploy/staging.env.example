# Copy to deploy/staging.env (ignored), mode 600. Values here are placeholders.
APP_ENV=staging
BACKEND_RUNTIME=node
NODE_ENV=production
APP_URL=https://swift-mc-vps-staging.YOUR-SUBDOMAIN.workers.dev
# Staging-only role; existing PostgreSQL 17 on loopback (127.0.0.1:5432) with verified TLS.
# Connect to loopback while verifying the Cloudflare Origin CA certificate for db-staging.swiftmc.com.br.
DATABASE_URL=postgresql://swiftmc_staging:REPLACE@db-staging.swiftmc.com.br:5432/swiftmc_staging?schema=public&sslmode=verify-full&hostaddr=127.0.0.1
DIRECT_DATABASE_URL=postgresql://swiftmc_staging:REPLACE@db-staging.swiftmc.com.br:5432/swiftmc_staging?schema=public&sslmode=verify-full&hostaddr=127.0.0.1
# Trusted Cloudflare Origin CA root certificate (not a leaf/key; never committed).
DATABASE_SSL_CA_PATH=/run/secrets/db-certs/origin-ca.pem
DATABASE_SSL_SERVERNAME=db-staging.swiftmc.com.br
PURCHASES_ENABLED=false
STRIPE_TEST_PURCHASES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BACKEND_PROXY_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
RESEND_API_KEY=
EMAIL_FROM=Swift MC Staging <noreply@YOUR-VERIFIED-DOMAIN>
MINECRAFT_BRIDGE_SECRET=
MINECRAFT_BRIDGE_SERVER_ID=swift-staging
MINECRAFT_BRIDGE_ALLOWED_SERVER_IDS=swift-staging
MINECRAFT_HOST=swiftmc.com
MINECRAFT_PORT=25565
MINECRAFT_PUBLIC_ADDRESS=swiftmc.com
