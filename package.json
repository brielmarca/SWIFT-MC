{
  "name": "nexus-mc-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "NODE_OPTIONS='--conditions=react-server' tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:auth-runtime": "node scripts/auth-runtime.mjs",
    "db:migrate:status": "node scripts/prisma-direct.mjs status",
    "db:migrate:deploy": "node scripts/prisma-direct.mjs deploy",
    "db:migrate:dev": "node scripts/prisma-direct.mjs dev",
    "test:db": "node scripts/test-db.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "postbuild:vinext": "next typegen",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "@vinext/cloudflare": "^1.0.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "^0.0.1",
    "vinext": "^1.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.28",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@cloudflare/config": {
      "zod": "$zod"
    },
    "miniflare": {
      "undici": "7.30.1"
    },
    "sharp@<0.35.5": "0.35.5",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "type": "module"
}
