# Local PostgreSQL development only (matches compose.yaml)
POSTGRES_DB="swiftmc"
POSTGRES_USER="swiftmc"
POSTGRES_PASSWORD="swiftmc_dev"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://swiftmc:swiftmc_dev@localhost:5433/swiftmc?schema=public"
DIRECT_DATABASE_URL="postgresql://swiftmc:swiftmc_dev@localhost:5433/swiftmc?schema=public"

# Server-only application and Mercado Pago Checkout Pro Orders API configuration
APP_URL="https://example.com"
MERCADOPAGO_ACCESS_TOKEN="replace-with-secret"
MERCADOPAGO_WEBHOOK_SECRET="replace-with-secret"

# Future server-only fulfillment and operations configuration
MINECRAFT_FULFILLMENT_URL="https://minecraft-bridge.example.com"
MINECRAFT_FULFILLMENT_TOKEN="replace-with-secret"
INTERNAL_JOB_SECRET="replace-with-secret"
ORDER_TOKEN_SECRET="replace-with-secret"
LOG_LEVEL="info"

# Server-only Java Server List Ping target (no protocol prefix in host)
MINECRAFT_HOST="play.swiftmc.net"
MINECRAFT_PORT="25565"
# Optional public connection address, if different from the query target
MINECRAFT_PUBLIC_ADDRESS="play.swiftmc.net"
# Official public Discord community invite
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/Bupp8tWvpu"

# Optional private player-data API (server-side only). Blank disables integration.
# Example URL: https://minecraft-data.example.com/v1/
MINECRAFT_DATA_API_URL=""
# Set the private API bearer token in the server environment; never use NEXT_PUBLIC_.
MINECRAFT_DATA_API_TOKEN=""
