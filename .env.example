# Deployment reference: docs/cloudflare-deployment.md
# VPS staging: use deploy/staging.env.example and docs/vps-staging.md instead.
# Public Workers pages do NOT need DATABASE_URL or payment credentials.
# Local PostgreSQL development only (demo credentials match compose.yaml).
# Do not copy this database/payment section into Cloudflare production settings.
POSTGRES_DB="swiftmc"
POSTGRES_USER="swiftmc"
POSTGRES_PASSWORD="swiftmc_dev"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://swiftmc:swiftmc_dev@localhost:5433/swiftmc?schema=public"
DIRECT_DATABASE_URL="postgresql://swiftmc:swiftmc_dev@localhost:5433/swiftmc?schema=public"
# Prisma 6 migrations use directUrl above. Production: direct PostgreSQL admin
# connection only, injected into trusted tooling; NEVER a Worker binding.
# Auth runtime binding/secret provisioning: docs/auth-infrastructure.md
# AUTH_HYPERDRIVE_ID is a non-secret build variable supplied through the build
# environment (never hardcoded). It declares AUTH_HYPERDRIVE only when set.
# AUTH_RATE_LIMIT_KEY and AUTH_ENCRYPTION_KEY are not wired by implemented code
# and are not declared as Worker bindings. Do not add them here.
# AUTH_RATE_LIMIT_NAMESPACE_ID is a non-secret build variable: the account-unique
# positive integer Cloudflare requires for the AUTH_RATE_LIMIT binding namespace.
# Unset or non-numeric values fall back to 1001. Use a distinct value per Worker
# (for example 1002 for staging) so environments do not share rate-limit counters.

# Server-only application and Mercado Pago Checkout Pro Orders API configuration
# Production origin is https://swiftmc.com.br. APP_URL is read as a Worker text
# binding in cloudflare.config.ts and as process.env in Next.js server code.
APP_URL="https://swiftmc.com.br"
MERCADOPAGO_ACCESS_TOKEN="replace-with-secret"
MERCADOPAGO_WEBHOOK_SECRET="replace-with-secret"

# Server-only Stripe configuration
# Purchases remain disabled unless explicitly enabled after staging validation.
PURCHASES_ENABLED="false"
# STRIPE_SECRET_KEY is used to authenticate calls to the Stripe API.
# STRIPE_WEBHOOK_SECRET is used to verify Stripe webhook signatures.
# Both are runtime secrets on the Worker, never build variables or NEXT_PUBLIC_ values.
STRIPE_SECRET_KEY="replace-with-secret"
STRIPE_WEBHOOK_SECRET="replace-with-secret"

# Server-only Resend email configuration (password reset, verification emails).
# RESEND_API_KEY is a runtime Secret on the Worker, never a build variable or
# NEXT_PUBLIC_ value. EMAIL_FROM is a non-secret text binding with a safe default.
RESEND_API_KEY="replace-with-secret"
EMAIL_FROM="noreply@swiftmc.com.br"

# Minecraft Bridge (polling plugin -> website API). Secrets are runtime-only.
# MINECRAFT_BRIDGE_SECRET is the Bearer token sent by the Paper plugin.
# Server identity is validated via X-Swift-Server against MINECRAFT_BRIDGE_SERVER_ID.
MINECRAFT_BRIDGE_SECRET="replace-with-random-secret-at-least-32-chars"
MINECRAFT_BRIDGE_SERVER_ID="swift-survival"
MINECRAFT_BRIDGE_ALLOWED_SERVER_IDS="swift-survival"

# Legacy/internal fulfillment integration (not required for the polling Bridge).
MINECRAFT_FULFILLMENT_URL="https://minecraft-bridge.example.com"
MINECRAFT_FULFILLMENT_TOKEN="replace-with-secret"
INTERNAL_JOB_SECRET="replace-with-secret"
ORDER_TOKEN_SECRET="replace-with-secret"
LOG_LEVEL="info"

# Server-only Java Server List Ping target (no protocol prefix in host).
# Workers: publicly reachable origin/DNS-only hostname, not a proxied Cloudflare IP.
# These non-secret values are read at build/deploy time into Worker text bindings.
MINECRAFT_HOST="swiftmc.com"
MINECRAFT_PORT="25565"
# Optional public connection address, if different from the query target
MINECRAFT_PUBLIC_ADDRESS="swiftmc.com"
# Official public Discord community invite. Public BUILD-TIME value; rebuild after changing.
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/Bupp8tWvpu"
# Public BUILD-TIME canonical origin for metadata, social previews, robots and sitemap.
# HTTPS origin only; no credentials/path/query. Rebuild after changing.
# Missing/invalid values safely fall back to https://swiftmc.com.br, never localhost.
NEXT_PUBLIC_SITE_URL="https://swiftmc.com.br"

# Optional private player-data API (server-side only). Blank disables integration.
# Example URL: https://minecraft-data.example.com/v1/
MINECRAFT_DATA_API_URL=""
# Set the private API bearer token in the server environment; never use NEXT_PUBLIC_.
# Workers: set this as a runtime Secret on swift-mc, not a build variable/text binding.
# Only required when MINECRAFT_DATA_API_URL is configured. Local value stays in .env.
MINECRAFT_DATA_API_TOKEN=""
